<Project>
  <!-- Evaluated after each project file, so the test/demo IsPackable=false overrides are
       visible here (a PropertyGroup condition in Directory.Build.props would not see them). -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- Pack fails if a release breaks the public API of 3.0.0. A package that does not exist at 3.0.0 yet must
         clear this in its own csproj until its first release, or pack cannot find the baseline. -->
    <PackageValidationBaselineVersion>3.0.0</PackageValidationBaselineVersion>
    <IsAotCompatible Condition="'$(IsAotCompatible)' == ''">true</IsAotCompatible>
  </PropertyGroup>
</Project>
