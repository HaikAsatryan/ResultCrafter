<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>EF Core integration for ResultCrafter ASP.NET Core. Maps an optimistic-concurrency DbUpdateConcurrencyException to a 409 RFC 9457 ProblemDetails via IExceptionHandler. Serialization failures and deadlocks (SQLSTATE 40001, 40P01) stay 500.</Description>
    <PackageTags>ef-core;aspnetcore;result-pattern;problem-details;problemdetails;concurrency;optimistic-concurrency;dbupdateconcurrencyexception;iexceptionhandler</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <!-- Open minimum floor (no brackets): consumers can use any later EF Core, including 11.x.
       The test project pins the latest patches for its own graph. This project still restores 10.0.0, so a
       future advisory on it would fail the -warnaserror build here; raise the floor then. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ResultCrafter.AspNetCore\ResultCrafter.AspNetCore.csproj"/>
  </ItemGroup>

</Project>
