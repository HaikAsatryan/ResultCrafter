<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Core primitives live in the flat root ResultCrafter namespace (files sit at the project
         root), so RootNamespace must be ResultCrafter, not the default project-name ResultCrafter.Core.
         Without this, IDE0130/dotnet_style_namespace_match_folder flags every root file. -->
    <RootNamespace>ResultCrafter</RootNamespace>
    <Description>Minimal Result pattern primitives for modern .NET: Result, and Error as readonly struct types. No ASP.NET Core dependency.</Description>
    <PackageTags>result;result-pattern;error;readonly-struct;csharp;dotnet;domain;application</PackageTags>
  </PropertyGroup>

</Project>