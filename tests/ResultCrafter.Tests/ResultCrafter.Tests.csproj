<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Native Microsoft.Testing.Platform runner (xunit.v3 built-in). global.json opts
         `dotnet test` into MTP on the .NET 10 SDK; Microsoft.NET.Test.Sdk and
         xunit.runner.visualstudio stay referenced per official xUnit guidance until all
         dev environments are confirmed on MTP. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0"/>
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.2.2"/>
  </ItemGroup>

  <!-- The EF Core references override the EfCore package's low open floors (8.0.0/9.0.0/10.0.0)
       so the repo's own build graph resolves the latest patches and stays NU1903-clean under
       the PR -warnaserror gate. Test-only; nothing here ships. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.28"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.28"/>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="9.0.17"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.17"/>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.9"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ResultCrafter.AspNetCore.EfCore\ResultCrafter.AspNetCore.EfCore.csproj"/>
    <ProjectReference Include="..\..\src\ResultCrafter.AspNetCore.FluentValidation\ResultCrafter.AspNetCore.FluentValidation.csproj"/>
    <ProjectReference Include="..\..\src\ResultCrafter.FluentValidation\ResultCrafter.FluentValidation.csproj"/>
    <ProjectReference Include="..\..\src\ResultCrafter.MediatR\ResultCrafter.MediatR.csproj"/>
  </ItemGroup>

</Project>
