<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The libraries ship net10.0 only; the tests run them on both the .NET 10 and .NET 11 runtimes. -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Native Microsoft.Testing.Platform runner (xunit.v3 built-in). global.json opts
         `dotnet test` into MTP; Microsoft.NET.Test.Sdk and
         xunit.runner.visualstudio stay referenced per official xUnit guidance until all
         dev environments are confirmed on MTP. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.1"/>
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.3"/>
  </ItemGroup>

  <!-- The EF Core references override the EfCore package's low open floor (10.0.0) so the
       repo's own build graph resolves the latest patches and stays NU1903-clean under the PR
       -warnaserror gate. The net11.0 pins also run the libraries against EF Core 11. OpenApi
       builds real OpenAPI documents to check the ProblemResponse schema. Test-only; nothing here ships. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15"/>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.15"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15"/>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0"/>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="11.0.0"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.0.0"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ResultCrafter.AspNetCore.EfCore\ResultCrafter.AspNetCore.EfCore.csproj"/>
    <ProjectReference Include="..\..\src\ResultCrafter.AspNetCore.FluentValidation\ResultCrafter.AspNetCore.FluentValidation.csproj"/>
    <ProjectReference Include="..\..\src\ResultCrafter.FluentValidation\ResultCrafter.FluentValidation.csproj"/>
  </ItemGroup>

</Project>
