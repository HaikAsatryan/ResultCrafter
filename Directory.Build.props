<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <WarningsAsErrors>$(WarningsAsErrors);Nullable</WarningsAsErrors>

    <IsPackable>true</IsPackable>

    <Authors>Haik</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/HaikAsatryan/ResultCrafter</RepositoryUrl>
    <PackageProjectUrl>https://github.com/HaikAsatryan/ResultCrafter</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <PackageIcon>ResultCrafterLogo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <Version>1.3.0</Version>
    <PackageReleaseNotes>Added the ResultCrafter.AspNetCore.FluentValidation package with the WithValidation&lt;T&gt;() endpoint filter (errors keys aligned to the configured JSON naming policy, camelCase by default). BadHttpRequestException now maps to its carried 4xx status code instead of 500, closing a Development/Production parity gap for Minimal API binding failures.</PackageReleaseNotes>

    <!-- Build quality -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Source/symbols -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Pack shared assets for all packable projects -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)ResultCrafterLogo.png" Pack="true" PackagePath="\"/>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>
</Project>
