<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <WarningsAsErrors>$(WarningsAsErrors);Nullable</WarningsAsErrors>

    <IsPackable>true</IsPackable>

    <Authors>Haik Asatryan</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/HaikAsatryan/ResultCrafter</RepositoryUrl>
    <PackageProjectUrl>https://github.com/HaikAsatryan/ResultCrafter</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <PackageIcon>ResultCrafterLogo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <Version>2.0.0</Version>
    <PackageReleaseNotes>BREAKING: core types moved from ResultCrafter.Core.Primitives to the ResultCrafter namespace; Minimal API extensions moved to ResultCrafter.AspNetCore, controller extensions to ResultCrafter.AspNetCore.Mvc; Result&lt;T&gt;.Ok / Created / Accepted now require a non-null value ([MemberNotNullWhen] makes Value flow-safe after an IsSuccess check). Fixed: controller To*Result error responses and the EF Core concurrency handler now set the HTTP transport status code (previously sent as 200 / 500 with a correct ProblemDetails body); ALL To*Result methods now enforce SuccessKind. Added: ErrorType.Gone (410), UnprocessableEntity (422), TooManyRequests (429) with factories, attributes, and builder extensions; Result.Match / Result&lt;T&gt;.Match; DebuggerDisplay on both Result structs. Error.BadRequest merges field-error keys differing only by case. EF Core dependency floors are open minimums (8.0.0 / 9.0.0 / 10.0.0). Packages marked AOT/trim-compatible (except ResultCrafter.MediatR).
    </PackageReleaseNotes>

    <!-- Build quality -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Source/symbols -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Pack shared assets for all packable projects -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)ResultCrafterLogo.png" Pack="true" PackagePath="\"/>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>
</Project>
