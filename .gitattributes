# Text files: LF in the repo and on checkout, so every machine and CI see the same bytes (.editorconfig says LF).
* text=auto eol=lf

# Windows shell scripts: CRLF on checkout, the line ending Windows shells expect.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Images and icons: never convert line endings, never show a text diff.
*.png binary
*.ico binary
